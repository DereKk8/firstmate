<details>
<summary>Evidence: Evidence script (real lib/env.sh sourced, compose contract + redis tests)</summary>

```text
#!/usr/bin/env bash
# Exercise the REAL runtime derivation function used by 'aide up'/'aide verify'/'aide restart'
# in dev mode (lib/env.sh:_derive_redis_env) taken from the worktree checkout.
set -u
WORKTREE="$1"
REPO=~/aide-env-check-root
rm -rf "$REPO"; mkdir -p "$REPO/.secrets"
ln -s "$WORKTREE/lib" "$REPO/lib"
printf 'canonical-redis-pw\n' > "$REPO/.secrets/redis_password.txt"

run_derive() {
  local name="$1" extra="$2"
  echo "==================== SCENARIO: $name ===================="
  env -i HOME="$HOME" PATH="$PATH" AIDE_ENV=dev REPO_ROOT="$REPO" EXTRA="$extra" bash -c '
    source "$REPO_ROOT/lib/env.sh"
    eval "$EXTRA"
    if _derive_redis_env; then
      echo "RESULT: OK"
      echo "REDIS_PASSWORD=$REDIS_PASSWORD"
      echo "REDIS_URL=$REDIS_URL"
      echo "CELERY_BROKER_URL=$CELERY_BROKER_URL"
      echo "CELERY_RESULT_BACKEND=$CELERY_RESULT_BACKEND"
      exit 0
    else
      echo "RESULT: FAILED (non-zero exit)"
      exit 1
    fi
  ' 2>&1
  echo
}

run_derive "matching REDIS_PASSWORD" "REDIS_PASSWORD=canonical-redis-pw"
run_derive "REDIS_URL + CELERY_* overrides" "REDIS_URL=redis://custom-host:6379/5 CELERY_BROKER_URL=redis://custom-broker:6379/2 CELERY_RESULT_BACKEND=redis://custom-result:6379/3"
run_derive "stale older .env REDIS_URL with changeme_redis pw" "REDIS_URL=redis://:changeme_redis@redis:6379/0"
run_derive "NON-matching REDIS_PASSWORD" "REDIS_PASSWORD=WRONG-PASSWORD"
run_derive "no REDIS_PASSWORD set (default bootstrap)" ""
```
</details>
